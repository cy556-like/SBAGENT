# ===== LLM 配置 =====
# 智谱 AI API Key（从 https://open.bigmodel.cn/ 获取）
LLM_API_KEY=your_api_key_here
# API 基础地址（智谱 AI 默认地址）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 默认使用的模型
LLM_MODEL=glm-5.1

# ===== LLM 备用配置（主Key失效时自动切换）=====
LLM_API_KEY_BACKUP=your_backup_api_key_here
LLM_BASE_URL_BACKUP=https://open.bigmodel.cn/api/paas/v4

# ===== Embedding 模型配置 =====
# Embedding 提供者：local（本地免费）或 openai（云端API）
EMBEDDING_PROVIDER=local
# 本地 Embedding 模型名称
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 云端 Embedding 模型名称（EMBEDDING_PROVIDER=openai 时使用）
EMBEDDING_MODEL=embedding-3
# [#12] Embedding 独立 API Key（如未设置则复用 LLM_API_KEY）
EMBEDDING_API_KEY=your_embedding_api_key_here
# Embedding API Base URL（如未设置则复用 LLM_BASE_URL）
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 外部系统集成（可选）=====
# GitHub Token（用于 GitHub API 工具）
GITHUB_TOKEN=
# SMTP 邮件配置（用于发送邮件工具）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 数据库连接（用于数据库查询工具）
DATABASE_URL=

# ===== 火山引擎（豆包/DeepSeek）独立配置 =====
# 豆包/DeepSeek 共用此配置，走火山引擎 Ark Coding API
# ⚠️ 重要：必须使用 /api/coding/v3 而非 /api/v3，后者会产生额外费用！
# 兼容 OpenAI 接口协议：https://ark.cn-beijing.volces.com/api/coding/v3
# 兼容 Anthropic 接口协议：https://ark.cn-beijing.volces.com/api/coding
# 模型 ark-code-latest 为 Auto 模式，自动选择最优模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# ===== 火山方舟标准 API（Doubao-Seed-2.1-Pro）=====
# 该模型不支持 Coding Plan，必须使用普通方舟 API Key 和 /api/v3。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 千问独立配置（阿里云百炼 DashScope，Qwen3.7-Max / Qwen3.7-Plus）=====
QWEN_API_KEY=
# 也兼容阿里云官方环境变量名 DASHSCOPE_API_KEY；两者存在时优先使用 QWEN_API_KEY。
# DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== MiMo独立配置（小米）=====
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ===== Kimi K3（Moonshot AI）独立配置 =====
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# ===== Feishu web SSO =====
# Keep FEISHU_APP_SECRET on the server only. Never expose it in frontend code.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://your-domain.example/api/v1/auth/feishu/callback
# Optional: bind selected open_id values to existing SBAGENT accounts.
# FEISHU_ACCOUNT_MAP_JSON={"ou_xxx":{"username":"adminsubao","role":"admin"}}
FEISHU_ACCOUNT_MAP_JSON=
FEISHU_SESSION_COOKIE=sbagent_session
# Comma-separated internal usernames with full upload/delete access to every
# knowledge base. adminsubao remains enabled even when omitted here.
FULL_KB_ADMIN_USERNAMES=adminsubao
# 通讯录全量同步使用；已通过飞书 SSO 登录过时可以留空自动识别
FEISHU_TENANT_KEY=
FEISHU_CONTACT_SYNC_ENABLED=true
FEISHU_CONTACT_FULL_SCOPE_CONFIRMED=false
# 留空则使用 data/feishu/contacts.sqlite3
FEISHU_CONTACTS_DB=

# ===== SQM fixed-account demonstration login =====
# This is not per-user SSO. Every valid entry signs in as one shared account.
# Keep the entry key only in backend configuration and rotate it if exposed.
SQM_DEMO_LOGIN_ENABLED=false
SQM_DEMO_USERNAME=jiangxy
SQM_DEMO_ENTRY_KEY=
# Only the shared demonstration account's chats and generated files are cleaned.
SQM_DEMO_RETENTION_DAYS=7
SQM_DEMO_SESSION_COOKIE=sbagent_session
